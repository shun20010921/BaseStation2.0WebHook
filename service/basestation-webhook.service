[Unit]
Description=VIVE Base Station Webhook Controller
After=network.target bluetooth.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/BaseStationWebhook
ExecStart=/opt/BaseStation2.0WebHook/venv/bin/python run.py serve
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
